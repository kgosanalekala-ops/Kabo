# ============================================================================
# KABO IT Group — Website Environment Variables
# ============================================================================
# Copy this file to `.env.local` for local development, or set these in your
# Vercel project settings (Project → Settings → Environment Variables) for
# production.
#
# ALL variables are optional. The site will run without SMTP configured —
# emails will be logged to the server console instead of being sent. To
# actually deliver emails, configure SMTP below.
# ============================================================================

# ---- SMTP relay (for contact form, support tickets, investor enquiries) ----
# These credentials are used by Nodemailer to send emails.
#
# Common SMTP providers:
#   Microsoft 365 / Outlook : smtp.office365.com  · port 587 · SECURE=false
#   Gmail (App Password)    : smtp.gmail.com      · port 587 · SECURE=false
#   SendGrid                : smtp.sendgrid.net   · port 587 · SECURE=false  · user=apikey
#   Postmark                : smtp.postmarkapp.com· port 587 · SECURE=false
#   Brevo (Sendinblue)      : smtp-relay.brevo.com· port 587 · SECURE=false

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@kaboitgroup.co.za
SMTP_PASSWORD=your-app-specific-password-here
SMTP_FROM="KABO IT Group <noreply@kaboitgroup.co.za>"

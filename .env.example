# ============================================================================
# KABO IT Group — Website Environment Variables
# ============================================================================
# Copy this file to `.env.local` for local development, or set these in your
# Vercel project settings (Project → Settings → Environment Variables) for
# production.
#
# ALL variables are optional. The site will run without any of them — form
# submissions are logged to the server console instead of being delivered.
# To actually deliver form submissions, configure at least ONE of the two
# delivery channels below.
#
# ============================================================================
# DELIVERY CHANNEL 1 — SMTP EMAIL (customer-facing auto-reply + team email)
# ============================================================================
# Used by Nodemailer to send:
#   - the polished HTML auto-reply to the customer who submitted the form
#   - the team notification email to info@ / support@ / kenny@ as appropriate
#
# Common SMTP providers:
#   Microsoft 365 / Outlook : smtp.office365.com  · port 587 · SECURE=false
#   Gmail (App Password)     : smtp.gmail.com      · port 587 · SECURE=false
#   SendGrid                 : smtp.sendgrid.net   · port 587 · SECURE=false  · user=apikey
#   Postmark                 : smtp.postmarkapp.com· port 587 · SECURE=false
#   Brevo (Sendinblue)       : smtp-relay.brevo.com· port 587 · SECURE=false

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@kaboitgroup.co.za
SMTP_PASSWORD=your-app-specific-password-here
SMTP_FROM="KABO IT Group <noreply@kaboitgroup.co.za>"

# ============================================================================
# DELIVERY CHANNEL 2 — WHATSAPP CLOUD API (silent team notification)
# ============================================================================
# Optional but recommended as a backup delivery channel.
#
# When configured, every form submission (contact, support ticket, investor
# enquiry) is ALSO sent as a WhatsApp message to the KABO team mobile —
# silently, server-side. The visitor never sees this; the UI always shows
# the email-style acknowledgement.
#
# This guarantees the KABO team actually receives the submission even if:
#   - SMTP is not yet configured
#   - the team inbox is full / quarantines the message
#   - a spam filter eats the auto-reply
#
# Setup (one-time, ~10 minutes):
#   1. Go to https://developers.facebook.com/ → My Apps → Create App
#      → Type: Business → Add product "WhatsApp"
#   2. In WhatsApp → API Setup, copy:
#        - Permanent Access Token         → WHATSAPP_TOKEN
#        - Phone Number ID (your test/   → WHATSAPP_PHONE_NUMBER_ID
#          business number)
#   3. From a phone that has the KABO WhatsApp number in its contacts,
#      send any message to your WhatsApp Business number once — this
#      "opts in" the recipient so the API can send messages back to it.
#   4. (Optional) Override the destination number with WHATSAPP_TO_NUMBER.
#      Defaults to 27612854418 (KABO SA mobile +27 612 85 4418).
#
# Leave all three blank to disable WhatsApp delivery (SMTP-only).

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=27612854418

# ============================================================================
# ROUTING SUMMARY (for reference — these are hard-coded in the API routes,
# NOT configurable via env, to prevent tampering)
# ============================================================================
#   /api/contact    → info@kaboitgroup.co.za           (+ WhatsApp)
#   /api/tickets    → support@kaboitgroup.co.za        CC info@   (+ WhatsApp)
#   /api/investor   → kenny@kaboitgroup.co.za           CC info@   (+ WhatsApp)
#
# The investor recipient (kenny@) is NEVER exposed in the public UI — the
# investor page only displays info@kaboitgroup.co.za to visitors.
